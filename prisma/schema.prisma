generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id         String      @id
  telegramId String?     @unique
  username   String?
  firstName  String?
  lastName   String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @default(now())

  balance    Balance?
  nest       Nest?
  dinosaurs  Dinosaur[]

  referralsSent   Referral[] @relation("ReferralInviter")
  referralSource  Referral?  @relation("ReferralInvited")
}

model Balance {
  id     String @id
  userId String @unique
  coins  Float  @default(50000)
  dna    Float  @default(100)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Nest {
  id                   String   @id
  userId               String   @unique
  currentEggs          Float    @default(12340)
  capacity             Float    @default(250000)
  lastProductionAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Dinosaur {
  id        String   @id
  userId    String
  level     Int      @default(1)
  boardSlot Int?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Referral {
  id                  String   @id
  inviterId           String
  invitedId           String   @unique
  inviterRewardCoins  Float    @default(500)
  inviteeRewardCoins  Float    @default(250)
  createdAt           DateTime @default(now())

  inviter User @relation("ReferralInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invited User @relation("ReferralInvited", fields: [invitedId], references: [id], onDelete: Cascade)

  @@index([inviterId])
}
