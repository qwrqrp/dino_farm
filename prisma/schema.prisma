generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id         String      @id
  telegramId String?     @unique
  username   String?
  firstName  String?
  lastName   String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @default(now())

  balance    Balance?
  nest       Nest?
  dinosaurs  Dinosaur[]

  referralsSent   Referral[] @relation("ReferralInviter")
  referralSource  Referral?  @relation("ReferralInvited")
  shopPurchases   ShopPurchase[]
  withdrawals     Withdrawal[]
  dailyReward     DailyReward?
  gameStats       GameStats?
  taskClaims      TaskClaim[]
  achievementClaims AchievementClaim[]
}

model Balance {
  id     String @id
  userId String @unique
  coins  Float  @default(50000)
  dna    Float  @default(100)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Nest {
  id                   String   @id
  userId               String   @unique
  currentEggs          Float    @default(12340)
  capacity             Float    @default(250000)
  lastProductionAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Dinosaur {
  id        String   @id
  userId    String
  level     Int      @default(1)
  boardSlot Int?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Referral {
  id                  String   @id
  inviterId           String
  invitedId           String   @unique
  inviterRewardCoins  Float    @default(500)
  inviteeRewardCoins  Float    @default(250)
  createdAt           DateTime @default(now())

  inviter User @relation("ReferralInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invited User @relation("ReferralInvited", fields: [invitedId], references: [id], onDelete: Cascade)

  @@index([inviterId])
}

model ShopItem {
  id          String   @id
  code        String   @unique
  title       String
  description String?
  priceCoins  Float
  kind        String
  amount      Float
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  purchases ShopPurchase[]
}

model ShopPurchase {
  id         String   @id
  userId     String
  shopItemId String
  priceCoins Float
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopItem ShopItem @relation(fields: [shopItemId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([shopItemId])
}


model Withdrawal {
  id              String   @id
  userId          String
  requestKey      String   @unique
  currency        String   @default("USDT")
  network         String
  walletAddress   String
  dnaAmount       Float
  rateUsdtPerDna  Decimal  @db.Decimal(18, 8)
  usdtAmount      Decimal  @db.Decimal(18, 8)
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  processedAt     DateTime?
  note            String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}


model DailyReward {
  id            String    @id
  userId        String    @unique
  streak        Int       @default(0)
  lastClaimedAt DateTime?
  totalClaims   Int       @default(0)
  totalCoins    Float     @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model GameStats {
  id                 String   @id
  userId             String   @unique
  totalEggsCollected Float    @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TaskClaim {
  id          String   @id
  userId      String
  taskCode    String
  rewardCoins Float
  claimedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskCode])
  @@index([userId])
}


model AchievementClaim {
  id              String   @id
  userId          String
  achievementCode String
  rewardCoins     Float
  claimedAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementCode])
  @@index([userId])
}
